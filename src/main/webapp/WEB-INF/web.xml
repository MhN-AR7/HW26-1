<!DOCTYPE web-app PUBLIC
 "-//Sun Microsystems, Inc.//DTD Web Application 2.3//EN"
 "http://java.sun.com/dtd/web-app_2_3.dtd" >

<web-app>
  <display-name>Archetype Created Web Application</display-name>

  <listener>
    <listener-class>ir.maktabsharif.util.AppContext</listener-class>
  </listener>
  

  <servlet>
    <servlet-name>AllBooksServlet</servlet-name>
    <servlet-class>ir.maktabsharif.servlet.AllBooksServlet</servlet-class>
  </servlet>
  
  <servlet>
    <servlet-name>AddBookServlet</servlet-name>
    <servlet-class>ir.maktabsharif.servlet.AddBookServlet</servlet-class>
    
    <init-param>
      <param-name>maxBooks</param-name>
      <param-value>50</param-value>
    </init-param>
  </servlet>
  
  
  <servlet-mapping>
    <servlet-name>AllBooksServlet</servlet-name>
    <url-pattern>/books</url-pattern>
  </servlet-mapping>
  
  <servlet-mapping>
    <servlet-name>AddBookServlet</servlet-name>
    <url-pattern>/add</url-pattern>
  </servlet-mapping>
</web-app>
